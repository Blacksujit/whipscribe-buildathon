# WhipScribe API Key (required for transcription)
WHIPSCRIBE_API_KEY=
# Legacy (misspelled) name, still read as a fallback - set either one
WHIPSKRIBE_API_KEY=

# GROQ API Key (required for LLM scoring)
GROQ_API_KEY=

# Provider (groq, openai, anthropic)
LLM_PROVIDER=groq

# Model name
LLM_MODEL=openai/gpt-oss-120b

# Slack webhook (optional alternative to the one-click OAuth flow)
SLACK_WEBHOOK_URL=

# Slack one-click OAuth (optional - register an app, then the Connect button is one click)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion integration (manual pasting flow)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Notion one-click OAuth (optional - register a public integration)
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# HubSpot private-app token (fallback when OAuth is not configured)
HUBSPOT_TOKEN=

# HubSpot one-click OAuth (optional - create a public app, then one click connects)
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Public URL used inside delivered messages and OAuth redirects
# Defaults to https://callcoachai.sujit.top when unset
PUBLIC_APP_URL=

# Flask session / OAuth-state signing key. Use a long random value in
# production (python -c "import secrets; print(secrets.token_hex(32))").
# Unset -> a random key per process (OAuth callbacks break across workers).
FLASK_SECRET_KEY=

# SQLite location (defaults to ./evaluations.db). Seeded from
# seed_evaluations.db on first start when empty.
DB_PATH=
