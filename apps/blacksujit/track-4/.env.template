# WhipScribe API key (create one at https://whipscribe.com/apis/keys after adding credit)
WHIPSKRIBE_API_KEY=your_key_here

# LLM provider for evaluation (openai | anthropic | ollama | groq)
LLM_PROVIDER=groq

# GROQ API key (if LLM_PROVIDER=groq) - get from https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# OpenAI API key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_key_here

# LLM model to use for evaluation (defaults to provider-specific model if not set)
LLM_MODEL=llama-3-3-70b-versatile

# Notion integration (for report delivery via --deliver notion)
# Create an integration at https://www.notion.so/my-integrations
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
