# WhipScribe API key (create one at https://whipscribe.com/apis/keys after adding credit)
WHIPSKRIBE_API_KEY=your_key_here

# LLM provider for evaluation (groq | openai | anthropic | ollama)
LLM_PROVIDER=groq

# GROQ API key (if LLM_PROVIDER=groq) - get one from https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# OpenAI API key (if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API key (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your_anthropic_key_here

# LLM model to use for evaluation (defaults to a provider-specific model if unset)
LLM_MODEL=openai/gpt-oss-120b

# Flask session secret (generate a random string for deployments)
FLASK_SECRET_KEY=change_me_to_a_random_string

# Where the Next.js dashboard runs (the API root route reports this URL)
FRONTEND_URL=http://localhost:3000

# Comma-separated CORS origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Slack incoming webhook (optional; also settable from the dashboard Settings page)
SLACK_WEBHOOK_URL=your_slack_webhook_here

# Notion integration (optional, for report delivery)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here

# Upload size limit in MB (optional, default 2048)
MAX_UPLOAD_MB=2048
