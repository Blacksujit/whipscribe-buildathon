data: {"jsonrpc":"2.0","id":3,"result":{"content":[{"type":"text","text":"{\"ok\": true, \"sentences\": [{\"idx\": 4, \"start\": 11.22, \"end\": 13.32, \"text\": \"May I speak with Janine Correa?\", \"speaker\": null, \"is_question\": true, \"has_hook\": false, \"has_number\": false, \"energy_avg\": 892.6}, {\"idx\": 18, \"start\": 56.64, \"end\": 60.76, \"text\": \"Are you the account holder or a person authorized to make decisions on the account?\", \"speaker\": null, \"is_question\": true, \"has_hook\": false, \"has_number\": false, \"energy_avg\": 824.7}, {\"idx\": 21, \"start\": 62.76, \"end\": 65.88, \"text\": \"Do you receive any government assistance For your energy bill?\", \"speaker\": null, \"is_question\": true, \"has_hook\": false, \"has_number\": false, \"energy_avg\": 1012.9}, {\"idx\": 23, \"start\": 67.54, \"end\": 71.34, \"text\": \"Okay, are you recently enrolling in Clean Sky Energy?\", \"speaker\": null, \"is_question\": true, \"has_hook\": false, \"has_number\": false, \"energy_avg\": 1037.8}]}"}],"isError":false}}

